{
	"name": "pl_send_email",
	"properties": {
		"activities": [
			{
				"name": "lk_read_tables_status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.audit_log WHERE adf_run_id = '@{pipeline().parameters.adf_run_id}'\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_asqldb_source",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set email body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingestion and Transformation Process for CARESYNC Project  Has Been Completed And Below Is The Status"
				}
			},
			{
				"name": "Set email body footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "for any queries please reach out mycareer369@gmail.com"
				}
			},
			{
				"name": "Set email subject",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "check failed status count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('check failed status count').output.firstRow.status_count,0),'FAILED','SUCCESS')} | CARE-SYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "check failed status count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT count(*) as status_count FROM ctrl.audit_log\nWHERE adf_run_id = '@{pipeline().parameters.adf_run_id}' AND status != 'SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_asqldb_source",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Set logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "lk_read_tables_status",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set email body header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set email body footer",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n  \"subject\":\"@{variables('email_subject')}\",\n  \"email_recepients\" : \"@{pipeline().globalParameters.email_recepients}\",\n  \"body_header\" : \"@{variables('body_header')}\",\n  \"body_footer\" : \"@{variables('body_footer')}\",\n  \"status_table\": @{activity('lk_read_tables_status').output.value}\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "send email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Set logic apps body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.logic_apps_url",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			}
		},
		"annotations": []
	}
}