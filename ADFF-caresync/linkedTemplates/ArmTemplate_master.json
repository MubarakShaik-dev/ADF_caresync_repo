{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADFF-caresync"
		},
		"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1031-154735-uywao80r"
		},
		"ls_adls_caresync_dev_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stcaresyncdev03.dfs.core.windows.net/"
		},
		"ls_asql_config_tabele_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server-caresyncc.database.windows.net"
		},
		"ls_asql_config_tabele_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_caresync"
		},
		"ls_keyvault_caresync_dev_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-caresync-dev-03.vault.azure.net/"
		},
		"ls_postgresql_caresync_dev_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-dark-leaf-b3ujh92g-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"ls_postgresql_caresync_dev_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgresql_caresync_dev_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADFF-caresync_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_caresync_dev_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_caresync_dev_properties_typeProperties_url')]"
					},
					"ls_asql_config_tabele_db_properties_typeProperties_server": {
						"value": "[parameters('ls_asql_config_tabele_db_properties_typeProperties_server')]"
					},
					"ls_asql_config_tabele_db_properties_typeProperties_database": {
						"value": "[parameters('ls_asql_config_tabele_db_properties_typeProperties_database')]"
					},
					"ls_keyvault_caresync_dev_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_caresync_dev_properties_typeProperties_baseUrl')]"
					},
					"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_postgresql_caresync_dev_properties_typeProperties_server": {
						"value": "[parameters('ls_postgresql_caresync_dev_properties_typeProperties_server')]"
					},
					"ls_postgresql_caresync_dev_properties_typeProperties_database": {
						"value": "[parameters('ls_postgresql_caresync_dev_properties_typeProperties_database')]"
					},
					"ls_postgresql_caresync_dev_properties_typeProperties_username": {
						"value": "[parameters('ls_postgresql_caresync_dev_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}