															"type": "Expression"
														}
													}
												}
											]
										}
									]
								},
								{
									"value": "adls_csv",
									"activities": [
										{
											"name": "cp_adls_source_to_adls_landing",
											"type": "Copy",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"source": {
													"type": "BinarySource",
													"storeSettings": {
														"type": "AzureBlobFSReadSettings",
														"recursive": false,
														"modifiedDatetimeStart": {
															"value": "@variables('water_mark_value')",
															"type": "Expression"
														},
														"deleteFilesAfterCompletion": false
													},
													"formatSettings": {
														"type": "BinaryReadSettings"
													}
												},
												"sink": {
													"type": "BinarySink",
													"storeSettings": {
														"type": "AzureBlobFSWriteSettings"
													}
												},
												"enableStaging": false
											},
											"inputs": [
												{
													"referenceName": "ds_Binary_for_source_csv",
													"type": "DatasetReference",
													"parameters": {
														"folder": {
															"value": "@activity('lk_get_source_table_details').output.firstRow.source_path",
															"type": "Expression"
														},
														"container": "source"
													}
												}
											],
											"outputs": [
												{
													"referenceName": "ds_Binary_for_source_csv",
													"type": "DatasetReference",
													"parameters": {
														"folder": {
															"value": "@concat(\n    activity('lk_get_source_table_details').output.firstRow.source_system,\n    '/',\n    activity('lk_get_source_table_details').output.firstRow.source_table_name,\n    '/',\n    variables('landing_timestamp')\n)",
															"type": "Expression"
														},
														"container": "landing"
													}
												}
											]
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
